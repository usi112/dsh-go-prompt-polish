{
  "name": "local-prompt-polish",
  "version": "1.3.0",
  "private": true,
  "description": "输入框上方的「优化提示词」胶囊：弹出确认页完整预览，复制后全选粘贴即可整体替换；也可显式追加",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
