{
  "name": "local-prompt-polish",
  "version": "1.5.0",
  "private": true,
  "description": "输入框上方的「优化提示词」胶囊：9 套场景预设 + 长度三档 + 本地固定模型，确认页先预览；配置写在本地 .config.json",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "提示词优化",
      "en": "Prompt polish"
    },
    "icon": "sparkle",
    "wants": [
      "draft"
    ],
    "contributes": {
      "composer.actions": [
        {
          "id": "polish",
          "label": {
            "zh": "优化提示词",
            "en": "Polish"
          },
          "icon": "sparkle"
        }
      ],
      "panels": [
        {
          "id": "polish-panel",
          "title": {
            "zh": "优化提示词",
            "en": "Polish prompt"
          },
          "icon": "sparkle",
          "placement": [
            "chat.panel",
            "session.tab"
          ]
        },
        {
          "id": "polish-settings",
          "title": {
            "zh": "提示词优化设置",
            "en": "Polish settings"
          },
          "icon": "settings",
          "placement": [
            "session.tab",
            "features"
          ]
        }
      ],
      "composer.tools": [
        {
          "id": "open-settings",
          "label": {
            "zh": "优化设置",
            "en": "Setup"
          },
          "icon": "settings",
          "panel": "polish-settings"
        }
      ]
    }
  }
}
