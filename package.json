          "icon": "sparkle"
        }
      ],
      "panels": [
        {
          "id": "polish-panel",
          "title": {
            "zh": "优化提示词",
            "en": "Polish prompt"
          },
          "icon": "sparkle",
          "placement": [
            "chat.panel",
            "session.tab"
          ]
        }
      ]
    }
